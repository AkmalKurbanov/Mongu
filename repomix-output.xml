    @include v.has-mouse
      &:hover
        .icon
          transform: translateX(3px)

  table
    border-collapse: collapse
    width: 100%
    tr
      td
        border: v.to-rem(1) solid v.$clr-secondary
        padding: v.to-rem(10) v.to-rem(7)
        font-size: v.$fz-xs

        @include v.media(tablet)
