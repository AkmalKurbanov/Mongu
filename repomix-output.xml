      <section class="section-padding-bottom">
        <div class="container">
          <div class="title-wrap">
            <h1 class="title">Create your journey</h1>
          </div>

          <div class="js-booking-container">
            <!-- ЭКРАН 0: Выбор пути -->
            <div class="booking-intro js-booking-intro">
              <div class="booking-intro__grid">
                <div class="booking-intro__card booking-intro__card_wa">
                  <div>
                    <svg class="icon"><use href="/icons.svg#whatsapp"></use></svg>
                    <h3 class="booking-intro__title">Fast booking via WhatsApp</h3>
                    <p class="booking-intro__desc">
                      Get instant confirmation and chat with our trip specialist in 1 click.
                    </p>
                  </div>
                  <a
                    href="https://wa.me/996555150795"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn_light js-whatsapp-fast-btn"
                    >Chat on WhatsApp</a
                  >
                </div>
                <div class="booking-intro__card booking-intro__card_form">
                  <div>
                    <svg class="icon"><use href="/icons.svg#form"></use></svg>
                    <h3 class="booking-intro__title">Book on Website</h3>
                    <p class="booking-intro__desc">
                      Select dates, customize your trip with add-ons, and fill out the details yourself.
                    </p>
                  </div>
                  <button type="button" class="btn js-start-wizard">Continue on Website</button>
                </div>
              </div>
            </div>

            <!-- САМ WIZARD (Теперь это полноценная форма) -->
            <form class="booking js-booking-wizard booking-hidden-elem" id="js-booking-form">
              <div class="booking__main">
                <!-- Прогресс-бар -->
                <div class="booking__progress">
                  <div class="booking__step booking__step_active" data-step="1">1. Selection</div>
                  <div class="booking__step" data-step="2">2. Details</div>
                  <div class="booking__step" data-step="3">3. Add-ons</div>
                  <div class="booking__step" data-step="4">4. Guest Info</div>
                </div>

                <div class="booking__panels">
                  <!-- ШАГ 1: Что бронируем -->
                  <div class="booking__panel js-booking-panel" data-panel="1">
                    <h2 class="booking__panel-title">What would you like to book?</h2>
                    <div class="booking__types booking__types_grid-flexible">
                      <!-- Добавлен data-item-type="tour" -->
                      <label class="booking-card">
                        <input
                          type="radio"
                          name="booking_type"
                          value="trekking"
                          data-item-type="tour"
                          class="booking-card__input"
                          checked />
                        <span class="booking-card__content">
                          <svg class="icon"><use href="/icons.svg#trekking"></use></svg>
                          <span class="booking-card__title">Trekking adventures</span>
                          <span class="booking-card__desc">Guided group & private treks</span>
                        </span>
                      </label>
                      <label class="booking-card">
                        <input
                          type="radio"
                          name="booking_type"
                          value="horseback"
                          data-item-type="tour"
                          class="booking-card__input" />
                        <span class="booking-card__content">
                          <svg class="icon"><use href="/icons.svg#horse"></use></svg>
                          <span class="booking-card__title">Horseback expedition</span>
                          <span class="booking-card__desc">Nomad mountain trails</span>
                        </span>
                      </label>
                      <label class="booking-card">
                        <input
                          type="radio"
                          name="booking_type"
                          value="jeep"
                          data-item-type="tour"
                          class="booking-card__input" />
                        <span class="booking-card__content">
                          <svg class="icon"><use href="/icons.svg#car"></use></svg>
                          <span class="booking-card__title">Overland jeep journeys</span>
                          <span class="booking-card__desc">Passes & lake expeditions</span>
                        </span>
                      </label>
                      <label class="booking-card">
                        <input
                          type="radio"
                          name="booking_type"
                          value="nomadic"
                          data-item-type="tour"
                          class="booking-card__input" />
                        <span class="booking-card__content">
                          <svg class="icon"><use href="/icons.svg#nomadic"></use></svg>
                          <span class="booking-card__title">Nomadic heritage</span>
                          <span class="booking-card__desc">Authentic cultural experiences</span>
                        </span>
                      </label>

                      <!-- Добавлен data-item-type="custom" -->
                      <label class="booking-card">
                        <input
                          type="radio"
                          name="booking_type"
                          value="custom"
                          data-item-type="custom"
                          class="booking-card__input" />
                        <span class="booking-card__content">
                          <svg class="icon"><use href="/icons.svg#map"></use></svg>
                          <span class="booking-card__title">Custom expedition</span>
                          <span class="booking-card__desc">Pre-designed unique itineraries</span>
                        </span>
                      </label>

                      <!-- Добавлен data-item-type="accommodation" -->
                      <label class="booking-card">
                        <input
                          type="radio"
                          name="booking_type"
                          value="sokmo"
                          data-item-type="accommodation"
                          class="booking-card__input" />
                        <span class="booking-card__content">
                          <svg class="icon"><use href="/icons.svg#tent"></use></svg>
                          <span class="booking-card__title">Sokmo Lodge</span>
                          <span class="booking-card__desc">Alpine camp experience</span>
                        </span>
                      </label>
                      <label class="booking-card">
                        <input
                          type="radio"
                          name="booking_type"
                          value="mongu"
                          data-item-type="accommodation"
                          class="booking-card__input" />
                        <span class="booking-card__content">
                          <svg class="icon"><use href="/icons.svg#hotel"></use></svg>
                          <span class="booking-card__title">Mongu Hotel</span>
                          <span class="booking-card__desc">Comfortable city stay</span>
                        </span>
                      </label>
                    </div>
                    <div class="btn-wrap">
                      <button type="button" class="btn js-next-step">Continue</button>
                    </div>
                  </div>

                  <!-- ШАГ 2: Даты и гости -->
                  <div class="booking__panel js-booking-panel booking-hidden-elem" data-panel="2">
                    <h2 class="booking__panel-title">Select dates & guests</h2>
                    <div class="form">
                      <div class="form__row js-tour-select-wrap">
                        <div class="form__group">
                          <label class="form__label">Select Tour</label>
                          <div class="custom-select js-custom-select">
                            <select name="tour_id" class="custom-select__native js-custom-select-native" hidden>
                              <option value="" disabled selected data-price="0">Choose a tour...</option>
                              <option value="ala-archa" data-price="600">Mountaineering in Ala-Archa</option>
                              <option value="karkyra" data-price="1300">Karkyra Horseback Expedition</option>
                            </select>
                            <div class="custom-select__trigger js-custom-select-trigger" tabindex="0">
                              <span class="custom-select__value js-custom-select-value">Choose a tour...</span>
                              <svg class="icon custom-select__arrow"><use href="/icons.svg#angle"></use></svg>
                            </div>
                            <div class="custom-select__dropdown">
                              <div class="custom-select__search-wrap">
                                <input
                                  type="text"
                                  class="custom-select__search js-custom-select-search"
                                  placeholder="Search tour..." />
                              </div>
                              <ul class="custom-select__list js-custom-select-list">
                                <li class="custom-select__option js-custom-select-option" data-value="ala-archa">
                                  Mountaineering in Ala-Archa
                                </li>
                                <li class="custom-select__option js-custom-select-option" data-value="karkyra">
                                  Karkyra Horseback Expedition
                                </li>
                              </ul>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div class="form__row form__row_col-2">
                        <div class="form__group">
                          <label class="form__label"
