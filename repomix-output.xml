  &__all-link
    text-align: center
    display: flex
    align-items: center
    justify-content: center
    font-weight: 500
    font-size: v.$fz-sm
    text-transform: uppercase
    margin: 0 auto
    width: max-content
    margin-top: v.$space-lg
