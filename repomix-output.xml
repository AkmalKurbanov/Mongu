<file path="src/sass/components/_header.sass">
@use '../settings/shared' as v

@mixin flex-center
  display: flex
  align-items: center

@mixin pseudo-element
  &::after
    position: absolute
    content: ''
    width: 100%
    height: v.to-rem(10)
    top: 100%
    left: 0

@mixin dropdown-menu
  display: flex
  flex-direction: column
  position: absolute
  top: calc(100% + v.to-rem(15))
  pointer-events: none
  opacity: 0
  transition: top v.$tr-base, opacity v.$tr-base
  z-index: 10
  width: max-content
  background-color: #fff
  list-style: none
  border-radius: v.$rad-sm
  box-shadow: v.$shadow-sm
  overflow: hidden

  .header__nav-sublink,
  .header__callback-link
    @include flex-center
    color: v.$clr-accent
    padding: v.$space-xs v.$space-md
    text-decoration: none
    text-align: left
    column-gap: v.$space-xs
    transition: background-color v.$tr-fast, color v.$tr-fast

    .icon
      transition: color v.$tr-base

    @include v.has-mouse
      &:hover
        color: #fff
        background-color: rgba(v.$clr-accent, .5)

@mixin dropdown-active
  opacity: 1
  pointer-events: auto
  top: calc(100% + v.to-rem(5))

.header
  &__nav-item
    @include pseudo-element
    @include v.has-mouse
      &:hover
        .header__nav-sublist
          @include dropdown-active

  &__nav-link
    @include v.has-mouse
      &:hover
        color: #ddd

  &__nav-sublist
    @include dropdown-menu
    left: 0

    &_full-width
      width: max-content
      left: 50%
      transform: translateX(-50%)
      display: grid
      grid-template-columns: repeat(3, 1fr)
      row-gap: v.$space-lg
      padding: v.$space-sm

      .header__nav-sublink  
        transition: opacity v.$tr-base 
        display: flex
        align-items: center
        column-gap: v.$space-sm

        @include v.has-mouse
          &:hover
            opacity: 0.8
            background: none
            color: v.$clr-accent

      .icon
        width: v.to-rem(58)
        height: v.to-rem(32)



  &__nav-subitem
    &:after
      display: none

  &__nav-sublink
    text-transform: inherit

  &__nav-sublist,
  &__callback-list
    opacity: 0
    position: absolute
    pointer-events: none

  &__controls
    @include v.has-mouse
      cursor: pointer

  &__btn, 
  &__callback-wrap
    @include v.has-mouse
      cursor: pointer

  &__callback
    @include pseudo-element
    &:hover
      .header__callback-list
        @include dropdown-active

  &__callback-list
    @include dropdown-menu
    right: 0
</file>

<file path="src/sass/components/_menu.sass">
@use '../settings/shared' as v

.menu
  position: fixed
  pointer-events: none
  opacity: 0
  width: 100%
  height: 100%
  inset: 0
  backdrop-filter: blur(10px)
  z-index: 10
  transition: opacity v.$tr-base

  &_is-open
    opacity: 1
    pointer-events: inherit
    .menu__sidebar
      top: 0

  &__sidebar
    position: absolute
    height: 100%
    background-color: #fff
    top: 100%
    transition: top v.$tr-base
    transition-delay: .2s
    width: 100%
    display: flex
    align-items: center
    flex-direction: column
    // padding: v.to-rem(70) 0 v.to-rem(30)

  &__sidebar-top
    display: flex
    align-items: center
    margin-bottom: v.$space-xl
    width: 100%
    padding: v.$space-lg v.$space-md 0

  &__logo
    width: v.to-rem(32)
    height: v.to-rem(32)
    display: flex
    align-items: center
    justify-content: center
    
    svg
      width: 100%
      height: 100%

  &__social
    flex-grow: 1

  &__close
    width: v.to-rem(40)
    height: v.to-rem(40)
    color: #fff
    background-color: #000
    border-radius: 100%
    display: flex
    align-items: center
    justify-content: center
    cursor: pointer

    .icon
      width: 100%
      height: 100%
 
  &__nav
    display: flex
    width: 100%
    height: 100%
    overflow-y: auto

  &__list
    display: flex
    flex-direction: column
    width: 100%

    @include v.media(laptop)
      justify-content: flex-start
      display: inline-flex
      width: auto

  &__item
    list-style: none
    margin-bottom: v.$space-md
    position: relative
    padding: 0 v.to-rem(16)

    @include v.media(tablet)
      justify-content: flex-start

    &:has(ul)
      display: inline-flex
      align-items: center
      flex-wrap: wrap
      justify-content: space-between

    &:last-child
      margin-bottom: 0

    // Теперь анимируем обертку
    &.is-droped
      .menu__submenu-wrapper
        grid-template-rows: 1fr
        opacity: 1

  &__item-link
    text-decoration: none
    color: v.$clr-text
    font-weight: 500
    font-size: v.$fz-base
    line-height: normal
    display: block

  &__submenu-wrapper
