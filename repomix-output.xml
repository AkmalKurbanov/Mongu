    color: v.$clr-text
    text-transform: uppercase
    letter-spacing: 0.05em

    &_bordered
      padding-bottom: v.$space-md
      border-bottom: v.to-rem(1) solid #e2e2e9
      margin-bottom: v.$space-md

  &__details
    display: grid
    gap: v.$space-md
    
   

  &__item
    display: flex
