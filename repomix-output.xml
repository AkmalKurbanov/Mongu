@use '../settings/shared' as v

.travel-guide
  padding-top: 40px
  padding-bottom: 80px

  &__header
    text-align: center
    margin-bottom: 40px
    padding: 0 16px

  &__title
    font-size: 32px
    font-weight: 700
    margin-bottom: 12px
    line-height: 1.2

    @media (min-width: 768px)
      font-size: 48px

  &__description
    font-size: 16px
    color: #555
    max-width: 600px
    margin: 0 auto
    line-height: 1.5

    @media (min-width: 768px)
      font-size: 18px

  &__list
    display: grid
    grid-template-columns: 1fr
    gap: 24px
    padding: 0 16px

    @media (min-width: 768px)
      grid-template-columns: repeat(2, 1fr)
      gap: 32px

    @media (min-width: 1024px)
      grid-template-columns: repeat(3, 1fr)

/* Компонент карточки статьи */
.guide-card
  background-color: #fff
  border-radius: 12px
