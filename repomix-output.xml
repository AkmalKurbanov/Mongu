    margin-top: v.to-rem(10)
    display: block
    margin-bottom: 0

  &__item-sublink
    font-size: v.to-rem(16)
    text-decoration: none
    color: v.$clr-text
    display: inline-flex
    align-items: center
    column-gap: v.$space-sm
    margin-bottom: 0
    .icon
      width: v.to-rem(36.25)
      height: v.to-rem(20)

  &__submenu-trigger
    flex-grow: 1
    display: flex
    justify-content: flex-end
    align-items: center
    border: none
    outline: none
    cursor: pointer
    background: none
    z-index: 20
    height: v.to-rem(24)
    position: relative

    @include v.media(tablet)
      flex-grow: 0
</file>

