<file path="src/sass/components/_destination.sass">
@use '../settings/shared' as v

.dest-mosaic
  display: flex
  flex-direction: column
  gap: v.$space-sm

  @include v.media(tablet)
    display: grid
    grid-template-columns: repeat(2, 1fr)
    grid-auto-flow: dense // Заполняет "дыры" в сетке

  @include v.media(laptop)
    grid-template-columns: repeat(4, 1fr)
    grid-auto-rows: v.to-rem(280) // Базовая высота ячейки сетки на десктопе

  &__item
    position: relative
    border-radius: v.$rad-md
    overflow: hidden
    display: flex
    flex-direction: column
    justify-content: flex-end
    min-height: v.to-rem(300) // Для мобилок
    background-color: #111 // Подложка
    
    // Градиент поверх картинки, чтобы текст всегда читался
    &::after
      content: ''
      position: absolute
      inset: 0
      background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.8) 100%)
      z-index: 1
      transition: background v.$tr-base

    @include v.media(laptop)
      min-height: auto // Высота управляется сеткой
      
      // Расставляем акценты для первых 5 элементов
      &:nth-child(1)
        grid-column: span 2
        grid-row: span 2
      &:nth-child(2),
      &:nth-child(5),
      &:nth-child(9)
        grid-column: span 2
      &:nth-child(3)
        grid-row: span 2

    @include v.has-mouse
      &:hover
        &::after
          background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.9) 100%)
        
        .dest-mosaic__bg img
          transform: scale(1.05) // Плавный зум

        // Раскрываем контент
        .dest-mosaic__reveal
          grid-template-rows: 1fr

  &__bg
    position: absolute
    inset: 0
    width: 100%
    height: 100%
    z-index: 0

    img
      width: 100%
      height: 100%
      object-fit: cover
      display: block
      transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)

  &__content
    position: relative
    z-index: 2
    padding: v.$space-lg
    color: #fff

    @include v.media(tablet)
      padding: v.$space-xl

  &__icon
    width: v.to-rem(40)
    height: v.to-rem(24)
    margin-bottom: v.$space-xs
    color: v.$clr-accent

  &__title
    font-family: v.$ff-accent
    font-size: v.$fz-xxl
    font-weight: 600
    margin: 0

  // Умный блок, который скрыт по умолчанию
  &__reveal
    display: grid
    grid-template-rows: 0fr
    transition: grid-template-rows 0.4s ease

    @include v.is-touch
      grid-template-rows: 1fr // На тачскринах показываем текст всегда

  &__reveal-inner
    overflow: hidden

    p
      margin-top: v.$space-sm
      font-size: v.$fz-sm
      line-height: 1.5
      color: rgba(255,255,255, 0.8)

      @include v.media(tablet)
        font-size: v.$fz-md

  &__btn
    display: inline-flex
    align-items: center
    gap: v.$space-xs
    margin-top: v.$space-sm
    font-size: v.$fz-xs
    font-weight: 600
    text-transform: uppercase
    letter-spacing: 0.05em
    color: v.$clr-accent

  &__link
    position: absolute
    inset: 0
    z-index: 5
</file>

<file path="src/sass/components/_form.sass">
@use '../settings/shared' as v

.form
  &__row
    margin-bottom: v.$space-md

    &_col-2
      @include v.media(tablet)
        display: grid
        grid-template-columns: 1fr 1fr
        gap: v.$space-md

  &__group
    display: flex
    flex-direction: column
    gap: v.to-rem(8)

  &__label
    font-size: v.$fz-sm
    font-weight: 600
    color: v.$clr-text

  &__input
    width: 100%
    padding: v.to-rem(12) v.$space-sm
    border: v.to-rem(1) solid #ccc
    border-radius: v.$rad-sm
    font-family: v.$ff-base
    font-size: v.$fz-md
    color: v.$clr-text
    background-color: #fff
    outline: none
    transition: border-color v.$tr-fast
    -webkit-appearance: none

    &:focus
      border-color: v.$clr-accent

    &_textarea
      resize: vertical
      min-height: v.to-rem(120)

  // Ошибки валидации October CMS
  &__error
    color: #f44336
    font-size: v.$fz-xs
    display: none
    margin-top: v.to-rem(4)

    &:not(:empty)
      display: block
      animation: fadeIn 0.3s ease

// --- КАСТОМНЫЙ СЕЛЕКТ (Универсальный) ---
.custom-select
  position: relative
  width: 100%
  user-select: none

  &__trigger
    display: flex
    align-items: center
    justify-content: space-between
    padding: v.to-rem(12) v.$space-sm
    background-color: #fff
    border: v.to-rem(1) solid #ccc
    border-radius: v.$rad-sm
    cursor: pointer
    transition: border-color v.$tr-fast, box-shadow v.$tr-fast
    outline: none

    &:hover, &:focus
      border-color: v.$clr-accent

  &__value
    font-size: v.$fz-md
    color: v.$clr-text
    white-space: nowrap
    overflow: hidden
    text-overflow: ellipsis

  &__arrow
    width: v.to-rem(20)
    height: v.to-rem(20)
    color: v.$clr-text-muted
    transition: transform v.$tr-base ease

  &_open &__trigger
    border-color: v.$clr-accent
    box-shadow: 0 0 0 v.to-rem(3) rgba(35, 179, 58, 0.1)

  &_open &__arrow
    transform: rotate(180deg)

  &__dropdown
    position: absolute
    top: calc(100% + 8px)
    left: 0
    right: 0
    background: #fff
    border: v.to-rem(1) solid #e2e2e9
    border-radius: v.$rad-sm
    box-shadow: v.$shadow-lg
    opacity: 0
    visibility: hidden
    transform: translateY(-10px)
    transition: opacity v.$tr-fast, transform v.$tr-fast, visibility v.$tr-fast
    z-index: 10
    padding: 0
    overflow: hidden

  &_open &__dropdown
    opacity: 1
    visibility: visible
    transform: translateY(0)

  &__search-wrap
    padding: v.$space-sm
    border-bottom: 1px solid #e2e2e9
    background-color: #f9f9fb

  &__search
    width: 100%
    padding: v.to-rem(8) v.$space-sm
    border: 1px solid #ccc
    border-radius: v.$rad-sm
    font-family: v.$ff-base
    font-size: v.$fz-sm
    outline: none
    transition: border-color v.$tr-fast

    &:focus
      border-color: v.$clr-accent

  &__list
    list-style: none
    margin: 0
    padding: v.$space-xs 0
    max-height: v.to-rem(220)
    overflow-y: auto

  &__option
    padding: v.$space-sm v.$space-md
    font-size: v.$fz-md
    color: v.$clr-text
    cursor: pointer
    transition: background-color v.$tr-fast, color v.$tr-fast

    @include v.has-mouse
      &:hover
        background-color: #f9f9fb
        color: v.$clr-accent

    &_selected
      background-color: rgba(35, 179, 58, 0.05)
      color: v.$clr-accent
      font-weight: 600

// --- СЧЕТЧИК ЛЮДЕЙ (Универсальный) ---
.pax-counter
  display: flex
  align-items: center
  border: v.to-rem(1) solid #ccc
  border-radius: v.$rad-sm
  overflow: hidden
  height: v.to-rem(46)

  &__btn
    width: v.to-rem(46)
    height: 100%
    background-color: #f9f9fb
    border: none
    font-size: v.$fz-lg
    color: v.$clr-text
    cursor: pointer
    transition: background-color v.$tr-fast

    @include v.has-mouse
      &:hover
        background-color: #e2e2e9

  &__input
    flex: 1
    height: 100%
    border: none
    text-align: center
    font-weight: 600
    font-size: v.$fz-md
    outline: none
    -moz-appearance: textfield

@keyframes fadeIn
  from
    opacity: 0
    transform: translateY(-5px)
  to
    opacity: 1
    transform: translateY(0)
</file>

